# Scoring de leads vía OpenRouter
OPENROUTER_API_KEY=sk-or-...
SCORE_ENABLED=true
SCORE_MODEL=openai/gpt-4.1-nano
SCORE_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
SCORE_TEMPERATURE=0