DATABASE_URL=sqlite:///./data/search_leads.db
GOOGLE_PLACES_API_KEY=your_key_here
API_KEY=dev-key-123
REDIS_URL=redis://localhost:6379/0
DEFAULT_MIN_RATING=4.3
DEFAULT_MAX_DAYS_SINCE_REVIEW=90
FREE_TS_ENTERPRISE_MONTHLY=1000
FREE_ENTERPRISE_MONTHLY=1000
COST_TS_ENTERPRISE_PER_1000=35.0
COST_ENTERPRISE_PER_1000=25.0
DETAIL_CACHE_HOURS=168
REQUEST_MAX_RETRIES=3
REQUEST_RETRY_BASE_DELAY=1.0
REQUEST_TIMEOUT=20.0
DETAILS_CONCURRENCY=5
USE_INCLUDED_TYPE=true
# Webhook de fin de corrida (done o failed)
WEBHOOK_URL=
WEBHOOK_ENABLED=false
